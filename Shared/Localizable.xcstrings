{
  "sourceLanguage": "ja",
  "strings": {
    "ディスク容量": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk Usage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク容量"
          }
        }
      }
    },
    "ボリュームの空き容量を表示します。下段の矢印ボタンで表示先を切り替えます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows available space on your volumes. Click the arrow on the bottom row to switch volumes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリュームの空き容量を表示します。下段の矢印ボタンで表示先を切り替えます。"
          }
        }
      }
    },
    "全容量 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全容量 %@"
          }
        }
      }
    },
    "外付けドライブ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External Drive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けドライブ"
          }
        }
      }
    },
