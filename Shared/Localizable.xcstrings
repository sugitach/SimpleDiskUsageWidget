      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No writable volumes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み可能なボリュームがありません"
          }
        }
      }
    },
    "次のボリューム": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Volume"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のボリューム"
          }
        }
      }
    },
